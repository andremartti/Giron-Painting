# Copy this file to `.env.local` and fill in the values.

# Endpoint that receives estimate requests as a JSON POST.
# Example (Formspree): https://formspree.io/f/your-form-id
VITE_ESTIMATE_FORM_ENDPOINT=

# Final public URL of the site, used for canonical links, Open Graph, and the sitemap.
# Example: https://www.example.com
SITE_URL=
